# Copy these placeholders into .env.development.local for local development.
# Use the separate arcanix-development project, not the production project.
NEXT_PUBLIC_SUPABASE_URL=https://your-development-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_development_publishable_key
ARCANIX_SUPABASE_DEV_PROJECT_REF=your-development-project-ref
NEXT_PUBLIC_ARCANIX_SUPABASE_DEV_PROJECT_REF=your-development-project-ref

# Never add SUPABASE_SERVICE_ROLE_KEY or any secret key to browser code.
